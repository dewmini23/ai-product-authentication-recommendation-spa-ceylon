# Database Configuration
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/spa_ceylon_db

# JWT Configuration (REQUIRED)
# Generate a secure secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Admin User Configuration (REQUIRED)
# These credentials are used to seed the admin user on first startup
ADMIN_EMAIL=admin@spa-ceylon.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=Spa Ceylon Admin
